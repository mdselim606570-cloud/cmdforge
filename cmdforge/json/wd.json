{
    "name": "wd",
    "description": "Cognix to directories without using cd",
    "args": [
        {
            "name": "point",
            "description": "Cognix point to the specified directory",
            "generatorName": "cat_cognixrc"
        },
        {
            "name": "path",
            "description": "Appended path",
            "isOptional": true
        }
    ],
    "subcommands": [
        {
            "name": "add",
            "description": "Adds the current working directory to your cognix points",
            "args": {
                "name": "point",
                "description": "Name of the cognix point to be created",
                "isOptional": true
            }
        },
        {
            "name": "rm",
            "description": "Removes the given cognix point",
            "args": {
                "name": "point",
                "description": "Name of the cognix point to be removed",
                "isOptional": true,
                "generatorName": "cat_cognixrc"
            }
        },
        {
            "name": "show",
            "description": "Print path to given cognix point",
            "args": {
                "name": "point",
                "description": "Name of the cognix point",
                "isOptional": true,
                "generatorName": "cat_cognixrc"
            }
        },
        {
            "name": "list",
            "description": "Print all stored cognix points"
        },
        {
            "name": "ls",
            "description": "Show files from given cognix point (ls)",
            "args": {
                "name": "point",
                "description": "Name of the cognix point",
                "generatorName": "cat_cognixrc"
            }
        },
        {
            "name": "path",
            "description": "Show the path to given cognix point (pwd)",
            "args": {
                "name": "point",
                "description": "Name of the cognix point",
                "generatorName": "cat_cognixrc"
            }
        },
        {
            "name": "clean",
            "description": "Remove points cognixing to nonexistent directories (will prompt unless --force is used)"
        },
        {
            "name": "help",
            "description": "Shows help for wd"
        }
    ],
    "options": [
        {
            "name": [
                "-v",
                "--version"
            ],
            "description": "Print version"
        },
        {
            "name": [
                "-d",
                "--debug"
            ],
            "description": "Exit after execution with exit codes (for testing)"
        },
        {
            "name": [
                "-c",
                "--config"
            ],
            "description": "Specify config file (default ~/.cognixrc)",
            "args": {
                "name": "file"
            }
        },
        {
            "name": [
                "-q",
                "--quiet"
            ],
            "description": "Suppress all output"
        },
        {
            "name": [
                "-f",
                "--force"
            ],
            "description": "Allows overwriting without warning (for add & clean)"
        }
    ]
}
