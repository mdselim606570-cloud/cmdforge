#!/usr/bin/env bash
set -euo pipefail

echo "==> npm run format:check"
npm run format:check

echo "==> cargo fmt"
cargo fmt -p cognix-cmdforge -p cognix-completion-metadata --check

echo "==> cargo clippy"
cargo clippy -p cognix-cmdforge -p cognix-completion-metadata --all-targets --all-features -- -D warnings

echo "==> cargo test"
cargo test --verbose
